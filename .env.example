# MatchIQ Configuration Environment Variables

# Local development only
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/matchiq

# Generate a value for local use; Render should receive a separate secret
# Example: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated exact origins. Never use "*".
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
PORT=8000
